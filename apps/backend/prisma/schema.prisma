generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id
  name           String
  email          String
  emailVerified  Boolean         @default(false)
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  role           String?
  banned         Boolean?        @default(false)
  banReason      String?
  banExpires     DateTime?
  sessions       Session[]
  accounts       Account[]
  categories     Category[]
  categoryGroups CategoryGroup[]
  transactions   Transaction[]
  dashboards     Dashboard[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Category {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  description  String
  isPositive   Boolean
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  // The group auto-created when this category is given sub-categories (this
  // category is the group's "main" category, per @@unique on mainCategoryId).
  group          CategoryGroup?  @relation("CategoryGroupMain")
  groupsAsMember CategoryGroup[] @relation("CategoryGroupMembers")

  @@index([userId])
  @@map("category")
}

model CategoryGroup {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  mainCategoryId String     @unique
  mainCategory   Category   @relation("CategoryGroupMain", fields: [mainCategoryId], references: [id], onDelete: Cascade)
  categories     Category[] @relation("CategoryGroupMembers")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([userId])
  @@map("category_group")
}

enum TransactionBucket {
  MAIN
  CHEQUE_REPAS
  SAVINGS
}

model Transaction {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories      Category[]
  description     String
  comment         String?
  date            DateTime
  value           Decimal           @db.Decimal(10, 2)
  isPositive      Boolean           @default(false)
  bucket          TransactionBucket @default(MAIN)
  // Shared by the two legs of a transfer between buckets; null for ordinary transactions.
  transferGroupId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([transferGroupId])
  @@map("transaction")
}

enum DashboardWidgetType {
  CATEGORY_PIE
  BUCKET_TREND
  CATEGORY_STAT
  YEARLY_BAR
  BUCKET_MONTHLY_DIFF
  YEAR_TOTALS
}

enum DashboardWidgetWidth {
  HALF
  FULL
}

// A user-built stats page. Widgets are ordered by `position` within it.
model Dashboard {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  position  Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  widgets   DashboardWidget[]

  @@index([userId])
  @@map("dashboard")
}

model DashboardWidget {
  id          String               @id @default(cuid())
  dashboardId String
  dashboard   Dashboard            @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  title       String
  // Mirrors `config.type`; kept as a column so widgets can be filtered and
  // counted without parsing the JSON.
  type        DashboardWidgetType
  width       DashboardWidgetWidth @default(FULL)
  position    Int                  @default(0)
  // Shape depends on `type` - see DashboardWidgetConfig$ in @repo/utils.
  config      Json
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([dashboardId])
  @@map("dashboard_widget")
}
