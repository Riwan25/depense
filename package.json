{
  "name": "depense",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "vp check",
    "deps": "ncu",
    "dev": "turbo run dev --ui=tui",
    "docker:db": "docker compose -f docker-compose.db.yml up -d",
    "docker:db:down": "docker compose -f docker-compose.db.yml down",
    "env:generate": "turbo run env:generate",
    "env:validate": "turbo run env:validate",
    "format": "vp fmt",
    "knip": "pnpm dlx knip",
    "lint": "vp lint",
    "prisma:format": "pnpm --filter backend run prisma:format",
    "prisma:generate": "pnpm --filter backend run prisma:generate",
    "prisma:migrate": "pnpm --filter backend run prisma:migrate",
    "prisma:migrate:deploy": "pnpm --filter backend run prisma:migrate:deploy",
    "prisma:validate": "pnpm --filter backend run prisma:validate",
    "release:prepare": "changeset",
    "release:push": "./scripts/release-push.sh",
    "release:version": "./scripts/release-version.sh"
  },
  "dependencies": {
    "varlock": "^1.3.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@repo/typescript-config": "workspace:*",
    "eslint-plugin-zod": "^4.5.3",
    "npm-check-updates": "^22.2.1",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "turbo": "^2.9.16",
    "typescript": "6.0.3",
    "vite-plus": "^0.1.23"
  },
  "packageManager": "pnpm@11.8.0"
}
